<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BotDifficultyProfilesDir Condition="'$(BotDifficultyProfilesDir)' == ''">difficulty</BotDifficultyProfilesDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.378" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BotControllerApi">
      <HintPath>libs\BotControllerApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <_DifficultyLevel Include="Low;Medium;High" Link="difficulty/%(Identity)/botprofile.db" />
    <Content Include="@(_DifficultyLevel->'$(BotDifficultyProfilesDir)/%(Identity)/botprofile.db')"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
